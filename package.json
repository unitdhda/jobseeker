{
  "name": "jobseeker",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cd packages/app && bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun --no-env-file test --max-concurrency=1 tests/*.test.ts packages/*/tests/*.test.ts",
    "test:postgres": "JOBSEEKER_POSTGRES_TEST_REQUIRED=1 bun --env-file=.env packages/app/tests/database-postgres.integration.ts"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/pg": "^8.20.3",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  },
  "workspaces": [
    "packages/*"
  ]
}
