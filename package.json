{
  "name": "hh-jobseeker",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env dist/server.mjs",
    "start:task-worker": "node --env-file-if-exists=.env dist/task-worker.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:postgres": "tsx --env-file=.env.cloud tests/database-postgres.integration.ts",
    "cv:prepare": "tsx --env-file-if-exists=.env src/scripts/prepare-cv.ts",
    "run:cycle": "tsx --env-file-if-exists=.env src/scripts/run-cycle.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.81.1",
    "@flue/postgres": "^2.0.0-nightly.202607240825",
    "@flue/runtime": "2.0.0-nightly.202607240825",
    "@google-cloud/tasks": "^6.3.0",
    "@hono/node-server": "^2.0.12",
    "@myriaddreamin/typst-ts-node-compiler": "0.7.0",
    "croner": "10.0.1",
    "grammy": "1.45.1",
    "hono": "4.12.32",
    "mammoth": "1.12.0",
    "node-html-parser": "9.0.1",
    "pdfjs-dist": "6.2.108",
    "pg": "^8.22.0",
    "playwright": "1.62.0",
    "unpdf": "1.8.0",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@flue/cli": "2.0.0-nightly.202607240825",
    "@flue/vite": "2.0.0-nightly.202607240825",
    "@types/node": "26.1.2",
    "@types/pg": "^8.20.3",
    "adm-zip": "0.6.0",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  },
  "overrides": {
    "sharp": "0.35.3",
    "adm-zip": "0.6.0"
  }
}
