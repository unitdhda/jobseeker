# Jobseeker environment reference. Existing process variables override --env-file values.
# Never commit populated secrets. Integer limits are inclusive; "positive" means >= 1.

# 1. Telegram token, owner, receiver mode, and webhook
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=
# polling | webhook | off. Exactly one receiver may own a bot token. Default: polling.
TELEGRAM_MODE=polling
# Legacy only when TELEGRAM_MODE is unset: true -> polling, false -> off.
# TELEGRAM_POLLING=true
# Webhook mode requires the full HTTPS public endpoint ending in /telegram/webhook and a 32–256 character [A-Za-z0-9_-] secret.
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# HTTP health/webhook listener, integer 1–65535. Default: 3000.
APP_PORT=3000

# 2. Extension provider selection and extension-specific source settings
# Directory containing copied deployment extensions. Default: ./extensions.
JOBSEEKER_EXTENSIONS=./extensions
# Comma-separated unique source IDs. Blank means every registered source.
SEARCH_PLATFORMS=
# HH extension defaults/ranges.
HH_AREA_ID=1
HH_MAX_PAGES=1
HH_OPERATION_TIMEOUT_SECONDS=180
HH_HEADLESS=true
HH_TIMEZONE=Europe/Moscow
HH_LANG=C.UTF-8
# Optional explicit installed Chromium executable.
HH_CHROMIUM_PATH=
# Claude CLI extension: local executable or private sidecar endpoint. Timeout is positive ms.
CLAUDE_CLI_PATH=claude
CLAUDE_CLI_CWD=
CLAUDE_CLI_TIMEOUT_MS=300000
CLAUDE_CLI_ENDPOINT=
CLAUDE_CLI_TOKEN=

# 3. Page/query/new-listing/normalization/refresh limits (all positive integers)
ADDITIONAL_MAX_PAGES=1
SEARCH_PAGE_BUDGET_PER_PLATFORM=12
SEARCH_QUERIES_PER_CYCLE=1
SEARCH_NEW_VACANCY_LIMIT=10
# Integer percent 0–100; converted to a fraction. Default: 60.
SEARCH_CLUSTER_SIMILARITY=60
VACANCY_RETENTION_DAYS=30
VACANCY_PURGE_BATCH_SIZE=500
NORMALIZATION_BATCH_SIZE_PER_USER=10
# Per-cycle cap for any one source and lease duration for crash-reclaimable normalization claims.
NORMALIZATION_PER_SOURCE_LIMIT=10
NORMALIZATION_CLAIM_LEASE_MINUTES=15
NORMALIZE_SOURCE_CONCURRENCY=3
DISCOVERY_TICK_CONCURRENCY=3
CANDIDATE_REFRESH_BATCH_SIZE=2
CANDIDATE_REFRESH_DAYS=7

# 4. Deterministic prefilter and advert age
# Score 0–100. Default: 20.
PREFILTER_MIN_SCORE=20
# Positive days. Default: 30.
PREFILTER_MAX_AGE_DAYS=30

# 5. AI credential file and model roles
# Local fallback credential document. Stored locked credentials take precedence. Default: ./auth/auth.json.
AI_AUTH_FILE=./auth/auth.json
# Model IDs use provider/model syntax. Doctor requires generation and scoring roles.
AI_MODEL=
AI_SCORING_MODEL=
# Optional dedicated roles; blank resolves lazily only if that role is invoked.
AI_PRESCORING_MODEL=
AI_SCORING_FALLBACK_MODEL=
# Optional: minimal | low | medium | high | xhigh | max.
AI_THINKING_LEVEL=
AI_SCORING_THINKING_LEVEL=
AI_PRESCORING_THINKING_LEVEL=
AI_SCORING_FALLBACK_THINKING_LEVEL=

# 6. Prescore/full-score batches, retries, thresholds, and exploration
# Scores are integers 0–100.
PRESCORE_MIN_SCORE=40
PRESCORE_BATCH_SIZE=10
PRESCORE_LIMIT_PER_CYCLE=60
# Decimal fraction 0 through 1; signs/exponents are rejected. Default: 0.1.
PRESCORE_EXPLORATION_RATE=0.1
PRESCORE_PROMPT_VERSION=v4
SCORE_BATCH_SIZE=3
SCORING_BATCH_TIMEOUT_SECONDS=180
SCORING_BATCH_MAX_ATTEMPTS=3
USER_SCORE_LIMIT_PER_CYCLE=3
# Cross-field: SCORE_AGENT_CONCURRENCY_MIN must be <= SCORE_AGENT_CONCURRENCY_MAX.
SCORE_AGENT_CONCURRENCY_MIN=5
SCORE_AGENT_CONCURRENCY_MAX=10

# 7. Per-user budget and artifact/profile limits
# Non-negative integer cents. Default: 200 ($2.00/day).
USER_DAILY_LLM_BUDGET_CENTS=200
USER_DAILY_APPLICATION_LIMIT=5
USER_DAILY_COVER_LETTER_LIMIT=20
# Cross-field: cover-letter limit must be >= tailored-CV application limit.
USER_DAILY_SEARCH_PROFILE_LIMIT=24
ACCESS_REQUEST_COOLDOWN_MINUTES=60
CV_UPLOAD_SESSION_COOLDOWN_MINUTES=15

# 8. Cadence and concurrency
# Cross-field: cadence floor must be <= cadence ceiling.
UNIT_CADENCE_FLOOR_MINUTES=30
UNIT_CADENCE_CEILING_MINUTES=720
USER_WORKFLOW_CONCURRENCY=5
DELIVERY_CONCURRENCY=5
MAX_PENDING_WORKER_JOBS=100
# true | false. Default: true. Engine execution is still protected by its PostgreSQL singleton lock.
RUN_JOBS=true

# 9. Delivery, timezone, and locale
# Scores 0–100; DIGEST_MIN_SCORE must be strictly below ALERT_SCORE.
DIGEST_MIN_SCORE=50
ALERT_SCORE=80
# Valid IANA time-zone identifier and ru | en locale.
TIMEZONE=Europe/Moscow
BOT_LOCALE=ru

# 10. PostgreSQL, TLS, and pool
DATABASE_URL=
POSTGRES_POOL_MAX=4
# disable | require | verify-full. Default: require.
POSTGRES_SSL=require
# Optional PEM CA certificate, typically needed with verify-full. Use a quoted multiline value if supported by your secret manager.
POSTGRES_CA_CERT=

# 11. Encrypted object state
# Supply all state-storage values together. Encryption key is a base64-encoded 32-byte AES-256 key.
STATE_STORAGE_URL=
STATE_STORAGE_KEY=
STATE_STORAGE_BUCKET=
RUNTIME_STATE_ENCRYPTION_KEY=

# 12. Browser profile path
# Persistent Chromium profile working directory. Encrypted snapshots may be stored through section 11.
HH_BROWSER_DATA_PATH=/app/data/hh-browser
# Extension child-process environment. Default TMPDIR: /tmp; PATH defaults to /usr/local/bin:/usr/bin:/bin.
TMPDIR=/tmp
PATH=/usr/local/bin:/usr/bin:/bin
