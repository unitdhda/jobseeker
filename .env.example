# Required
TELEGRAM_BOT_TOKEN=
# Owner private chat and user IDs; for a private chat these values must match.
TELEGRAM_CHAT_ID=
TELEGRAM_USER_ID=
TYPST_FONT_PATHS=./fonts

# Retained vacancy sources.
SEARCH_PLATFORMS=hh,habr,rabota,hirehi

# HH browser search
HH_AREA_ID=1
PLAYWRIGHT_CHROMIUM_PATH=
PLAYWRIGHT_HEADLESS=true
HH_MAX_PAGES=5
# Close a stalled per-user HH browser search so the rest of the cycle can finish.
HH_OPERATION_TIMEOUT_SECONDS=180

# Habr Career, Работа.ру, and HireHi
ADDITIONAL_MAX_PAGES=5
HIREHI_MAX_PAGES=5
SEARCH_PAGE_BUDGET_PER_PLATFORM=12
# Stop each user/platform search after this many globally unseen vacancies, or at the page cap above.
SEARCH_NEW_VACANCY_LIMIT=10
NORMALIZATION_BATCH_SIZE_PER_USER=10
CANDIDATE_PREFILTER_BATCH_SIZE=1000
CANDIDATE_REFRESH_BATCH_SIZE=2
CANDIDATE_REFRESH_DAYS=7

# Lightweight CV-derived title/skill and lexical prefilter before LLM scoring.
PREFILTER_ENABLED=true
PREFILTER_BATCH_SIZE=500
PREFILTER_MIN_SCORE=20
PREFILTER_AUDIT_PERCENT=5
PREFILTER_AUDIT_SLOTS=1
PREFILTER_CALIBRATION_MIN_LABELS=100

# Premium subscription model for search-profile and application generation.
AI_MODEL=openai-codex/gpt-5.6-terra
AI_THINKING_LEVEL=high
# Lower-cost ChatGPT subscription model for batched vacancy scoring.
AI_SCORING_MODEL=openai-codex/gpt-5.6-luna
AI_SCORING_THINKING_LEVEL=medium
SCORE_BATCH_SIZE=3
# Abort and retry a scoring batch that stops producing a response.
SCORING_BATCH_TIMEOUT_SECONDS=180
SCORING_BATCH_MAX_ATTEMPTS=3
# If the ChatGPT subscription reports a terminal usage-limit error, scoring falls back to this metered API model.
# Leave OPENAI_API_KEY empty to disable paid fallback.
AI_SCORING_FALLBACK_MODEL=openai/gpt-5.4-mini
AI_SCORING_FALLBACK_THINKING_LEVEL=medium
OPENAI_API_KEY=
ALERT_SCORE=80
DIGEST_MIN_SCORE=50
# One process tick runs scraping/scoring, due alerts, and user-scheduled digests.
CYCLE_CRON=*/30 * * * *
TIMEZONE=Europe/Moscow
# Shared adaptive LLM scoring pool: 5 workers at normal load, scaling to 10 as work queues.
SCORE_AGENT_CONCURRENCY_MIN=5
SCORE_AGENT_CONCURRENCY_MAX=10
# Each user gets this many scoring attempts per cycle; there is no global or daily scoring cap.
USER_SCORE_LIMIT_PER_CYCLE=3
USER_DAILY_APPLICATION_LIMIT=5
# Profile calls are per platform; 7 permits one full refresh of the default seven platforms.
USER_DAILY_SEARCH_PROFILE_LIMIT=7
# Different users may prepare profiles and score concurrently.
USER_WORKFLOW_CONCURRENCY=5
# User/platform scrape tasks overlap; the shared HH browser remains serialized.
SCRAPE_CONCURRENCY=8
# Bounded Telegram alert/digest fan-out avoids API bursts.
DELIVERY_CONCURRENCY=5
MAX_PENDING_WORKER_JOBS=100
ACCESS_REQUEST_COOLDOWN_MINUTES=60
CV_UPLOAD_SESSION_COOLDOWN_MINUTES=15
RUN_JOBS=true
# Disable only the immediate startup scan while retaining cron schedules.
RUN_INITIAL_CYCLE=true
# Local/VPS mode. Cloud Run uses TELEGRAM_MODE=webhook and a random 32+ character secret.
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
# Cloud webhook mode: persist each update before dispatching it to the private worker through Cloud Tasks.
TELEGRAM_WEBHOOK_ASYNC=false
CLOUD_TASKS_PROJECT=
CLOUD_TASKS_LOCATION=
CLOUD_TASKS_QUEUE=
CLOUD_TASKS_WORKER_URL=
CLOUD_TASKS_SERVICE_ACCOUNT=
# Defaults to CLOUD_TASKS_WORKER_URL when empty.
CLOUD_TASKS_AUDIENCE=
# Random 32+ character secret shared only by Cloud Tasks and the private task worker.
TASK_EXECUTION_SECRET=
BACKGROUND_TASK_LEASE_MS=300000
# The singleton Cloud Run cycle job enqueues due alert and digest deliveries through Cloud Tasks.
BACKGROUND_DELIVERY_ASYNC=false
# Legacy fallback when TELEGRAM_MODE is unset.
TELEGRAM_POLLING=true
APP_PORT=3000

# Cloud persistence and encrypted runtime state (supply through secret storage, never commit values).
DATABASE_URL=
POSTGRES_POOL_MAX=4
POSTGRES_SSL=require
POSTGRES_CA_CERT=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=jobseeker-private-state
RUNTIME_STATE_ENCRYPTION_KEY=
HH_BROWSER_DATA_PATH=/tmp/hh-browser
