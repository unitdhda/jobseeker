# Required
TELEGRAM_BOT_TOKEN=
# Owner private chat and user IDs; for a private chat these values must match.
TELEGRAM_CHAT_ID=
TELEGRAM_USER_ID=
TYPST_FONT_PATHS=./fonts

# Which registered sources run discovery. Unset (or empty) means every provider the extensions registered;
# providers come from the extensions directory (see extensions/README.md), not from the application itself.
# Probe every optional source from the machine that will scrape before naming it here.
SEARCH_PLATFORMS=

# Работа России open register; federal region code, default Москва.
TRUDVSEM_REGION=7700000000
# Company ATS boards as provider:slug entries. Providers: greenhouse, lever, ashby, smartrecruiters.
# These boards publish no customer directory, so each company is listed explicitly.
ATS_BOARDS=greenhouse:stripe,greenhouse:figma,lever:netflix,ashby:ramp

# HH browser search
# HH_* and PLAYWRIGHT_* are read by the hh extension (extensions/hh), not by the application itself.
HH_AREA_ID=1
PLAYWRIGHT_CHROMIUM_PATH=
PLAYWRIGHT_HEADLESS=true
HH_MAX_PAGES=1
# Close a stalled per-user HH browser search so the rest of the cycle can finish.
HH_OPERATION_TIMEOUT_SECONDS=180

# Listing pages fetched per search for the example fetch-based sources.
ADDITIONAL_MAX_PAGES=1
SEARCH_PAGE_BUDGET_PER_PLATFORM=12
# Searches fetched per platform per cycle is this times the number of users; the plan then spends that budget on
# clusters of equivalent searches rather than on one query per user, so a shared query is fetched once.
SEARCH_QUERIES_PER_CYCLE=1
# Token overlap, in percent, at which two users' searches count as one query. 100 merges only identical queries.
SEARCH_CLUSTER_SIMILARITY=60
# Stop each platform's planned searches after this many globally unseen vacancies, or at the page cap above.
SEARCH_NEW_VACANCY_LIMIT=10
# Retention. A vacancy is deleted once the sources have stopped returning it for this long and it is itself this
# old, and the store never serves anything older. Age alone is not enough: deleting a listing a source still
# advertises means fetching, scoring and delivering it a second time.
VACANCY_RETENTION_DAYS=30
VACANCY_PURGE_BATCH_SIZE=500
NORMALIZATION_BATCH_SIZE_PER_USER=10
# How many sources normalize queued candidates at once. Keep modest: each source stream is still sequential
# per host, but a browser-backed source (~50s/candidate) no longer blocks sub-second API sources behind it.
NORMALIZE_SOURCE_CONCURRENCY=3
# How many platforms may scrape concurrently inside one discovery tick; platform hosts are disjoint.
DISCOVERY_TICK_CONCURRENCY=3
CANDIDATE_REFRESH_BATCH_SIZE=2
CANDIDATE_REFRESH_DAYS=7

# Lightweight CV-derived title/skill and lexical prefilter before LLM scoring. This score is cheap but a weak,
# non-monotonic predictor of what the LLM will actually like, so it is a poor thing to gate hard on. Once a
# calibration exists, prefer PREFILTER_MIN_PROBABILITY below as the real gate and keep this as a low backstop:
# it is the only thing standing between you and admitting everything if the calibration ever goes missing.
PREFILTER_MIN_SCORE=20
# Adverts older than this are rejected outright however well they match, measured against the advert's own
# publication date as read from the source. Inside the limit, age only discounts the score.
PREFILTER_MAX_AGE_DAYS=30

# --- Self-calibrating prefilter -------------------------------------------------------------------------------
# The prefilter decides which matches the LLM looks at first, and left alone it is a mediocre predictor of what the
# LLM will actually like. So the service re-fits that ordering from its own past LLM verdicts, once a day, and
# adopts the new one only when it demonstrably orders no worse than what is running. You can ignore this section
# entirely: the defaults are the intended behaviour.

# Refit daily inside the running service. Turn this off to freeze the ordering exactly as it is today.
CALIBRATION_AUTO_REFIT=true
# How many scored matches must exist before a refit is attempted at all. Below this there is not enough evidence
# for the comparison to mean anything, and the service keeps whatever ordering it already has.
CALIBRATION_MIN_LABELS=300
# Optional starting coefficients, as JSON, for a brand-new deployment with no verdicts of its own yet. Any refit
# the service later accepts outranks this, so it is a bootstrap rather than a setting to maintain.
# PREFILTER_CALIBRATION_JSON=
# Minimum calibrated P(good), as a percentage, for a match to be scored at all. This is the sharp filter: it acts
# on the calibrated probability, which is measurably better at predicting the LLM's verdict than the raw evidence
# score PREFILTER_MIN_SCORE tests. It does nothing until a calibration is active, and 0 leaves admission to the
# raw gate alone. Raise it to spend less on obvious misses; measure first, because the cost is paid in matches
# the user never sees. Rejections here still face the exploration dice below.
PREFILTER_MIN_PROBABILITY=0
# The share of below-the-bar matches scored anyway, purely to find out whether the bar is in the right place.
# Every match the prefilter rejects is a verdict never observed, so a calibration fitted only on what it already
# admits can never discover its own blind spots. Costs model spend in proportion: 0.1 means roughly one extra
# scored match in ten. 0 disables it.
PREFILTER_EXPLORATION_RATE=0

# Model selection is deliberately left to you: nothing is hardcoded, so a role whose variable is blank fails at
# request time naming the variable. Any provider/model from the pi-ai catalog may be set; credentials come from
# the provider's usual environment variable (for example OPENAI_API_KEY) or from the auth.json credential store
# at AI_AUTH_FILE, whichever the operator prefers. Subscription-backed providers such as openai-codex/<model>
# keep their OAuth credential in that store; extensions may register further providers of their own.
# Credential store path (JSON document keyed by provider id). Defaults to ./auth/auth.json.
AI_AUTH_FILE=
# Model for search-profile and application generation.
AI_MODEL=
AI_THINKING_LEVEL=
# Model for batched vacancy scoring; usually the cheaper of the two.
AI_SCORING_MODEL=
AI_SCORING_THINKING_LEVEL=
SCORE_BATCH_SIZE=3
# Abort and retry a scoring batch that stops producing a response.
SCORING_BATCH_TIMEOUT_SECONDS=180
SCORING_BATCH_MAX_ATTEMPTS=3
# If the subscription provider reports a terminal usage-limit error, scoring falls back to this metered model.
# Leave blank to disable paid fallback; its provider needs credentials via env or the credential store.
AI_SCORING_FALLBACK_MODEL=
AI_SCORING_FALLBACK_THINKING_LEVEL=
OPENAI_API_KEY=
ALERT_SCORE=80
DIGEST_MIN_SCORE=50
TIMEZONE=Europe/Moscow
# Interface language of the bot: ru or en. It applies to anyone whose Telegram client language is not one the bot
# speaks, and until they pick a language with /language. Model-written text follows the vacancy, not this setting.
BOT_LOCALE=ru
# Shared adaptive LLM scoring pool: 5 workers at normal load, scaling to 10 as work queues.
SCORE_AGENT_CONCURRENCY_MIN=5
SCORE_AGENT_CONCURRENCY_MAX=10
# Each user gets this many scoring attempts per cycle; there is no global or daily scoring cap.
USER_SCORE_LIMIT_PER_CYCLE=3
# Scoring stops claiming for a user once the day's LLM spend recorded in `accounts` reaches this ceiling (cents).
USER_DAILY_LLM_BUDGET_CENTS=200
# How often a search unit may run: novelty halves the cadence toward the floor, silence stretches it toward the
# ceiling (minutes).
UNIT_CADENCE_FLOOR_MINUTES=30
UNIT_CADENCE_CEILING_MINUTES=720
# The tailored CV and the cover letter are requested by separate buttons and budgeted separately, because not
# every vacancy is worth a fresh CV and not every one takes a letter. Both count deliveries per user per 24h.
USER_DAILY_APPLICATION_LIMIT=5
USER_DAILY_COVER_LETTER_LIMIT=20
# Profile calls are counted per platform, so this must be at least SEARCH_PLATFORMS × the refreshes you want to
# allow: 24 permits three full refreshes of the default eight platforms. Below the platform count, a CV upload
# can never regenerate profiles at all.
USER_DAILY_SEARCH_PROFILE_LIMIT=24
# Different users may prepare profiles and score concurrently.
USER_WORKFLOW_CONCURRENCY=5
# Bounded Telegram alert/digest fan-out avoids API bursts.
DELIVERY_CONCURRENCY=5
MAX_PENDING_WORKER_JOBS=100
ACCESS_REQUEST_COOLDOWN_MINUTES=60
CV_UPLOAD_SESSION_COOLDOWN_MINUTES=15
RUN_JOBS=true
# polling suits a single long-running process. A webhook deployment sets TELEGRAM_MODE=webhook, a public HTTPS
# TELEGRAM_WEBHOOK_URL, and a random 32+ character secret — and then nothing anywhere may poll the same token.
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
# Legacy fallback when TELEGRAM_MODE is unset.
TELEGRAM_POLLING=true
APP_PORT=3000

# Database and optional encrypted runtime state (supply through secret storage, never commit values).
DATABASE_URL=
POSTGRES_POOL_MAX=4
POSTGRES_SSL=require
POSTGRES_CA_CERT=
# Optional. Object storage for encrypted runtime state (OAuth credentials, browser state), so a container
# recreation does not lose them. Any endpoint serving the /storage/v1/object route with a bearer key works.
# All four are required together; set none of them to keep that state on local disk instead.
STATE_STORAGE_URL=
STATE_STORAGE_KEY=
STATE_STORAGE_BUCKET=jobseeker-private-state
# 32 bytes, hex. Losing it makes everything already written to that bucket unreadable.
RUNTIME_STATE_ENCRYPTION_KEY=
HH_BROWSER_DATA_PATH=/tmp/hh-browser
